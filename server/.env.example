# AI 运动管家 - 环境变量配置
# 复制此文件为 .env 并修改配置

# 服务器
DEBUG=true

# 数据库 (MVP 使用 SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/sports_manager.db

# JWT 密钥 (请修改为随机字符串)
JWT_SECRET=change-me-to-a-random-string

# LLM 配置 (通义千问/DashScope)
LLM_PROVIDER=qwen
LLM_MODEL=qwen-max
LLM_VISION_MODEL=qwen-vl-max
LLM_API_KEY=
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 备用 LLM (可选)
# LLM_FALLBACK_PROVIDER=wenxin
# LLM_FALLBACK_MODEL=ernie-4.0
# LLM_FALLBACK_API_KEY=

# 文件存储
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100

# 功能开关
ENABLE_AI_RATING=true
ENABLE_MOTION_ANALYSIS=true
FOOD_CONFIDENCE_THRESHOLD=0.7
